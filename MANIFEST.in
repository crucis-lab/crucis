include README.md AGENTS.md .commit-policy.json LICENSE NOTICE CITATION.cff THIRD_PARTY_NOTICES.md
recursive-include LICENSES *.txt
recursive-include crucis_causal *.py *.json *.txt *.sha256
prune crucis_causal/docs
include crucis_causal/docs/system-connections-sc1-example-2026-11-01.json
include crucis_causal/docs/subsystem2-review-traceability-2026-11-02.json
