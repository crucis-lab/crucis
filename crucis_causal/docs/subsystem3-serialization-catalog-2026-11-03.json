  "lexical_rules": {
    "ID": "lowercase UUIDv4; source/native IDs remain separate scoped values",
    "QName": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
    "Index": "^(0|[1-9][0-9]*)$",
    "IntegerText": "^-?(0|[1-9][0-9]*)$",
    "DecimalText": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
    "String": "Unicode scalar sequence without normalization; unknown native encoding remains bytes",
    "Code": "QName; selecting a code does not install its meaning",
    "Boolean": "JSON true or false; never a Number",
    "raw_numeric_tokens": "forbidden in interpreted S3 structural tree, including extension JSON; opaque BytePayload text may contain native numeric tokens",
    "null": "forbidden in interpreted structural slots; native null may be retained in opaque evidence",
    "Hex64": "^[0-9a-f]{64}$",
    "Contract.version": "nonempty exact version string; no range/latest semantics",
    "Time.utc_instant": "valid calendar instant with explicit Z; precision tag matches seconds/fractional seconds; uncertainty finite nonnegative when known",
    "BytePayload.inline_base64": "strict base64 with padding, no ignored nonalphabet characters; decoded bytes preserved"
  },
